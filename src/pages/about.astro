---
import Layout from '../layouts/Layout.astro';
import CareerIntroduction from '../features/resume/CareerIntroduction.astro';
import CareerOverview from '../features/resume/CareerOverview.astro';
import ResumeFooter from '../features/resume/ResumeFooter.astro';
import ResumeHeader from '../features/resume/ResumeHeader.astro';
import ResumeMetaRow from '../features/resume/ResumeMetaRow.astro';
import { getResume } from '../features/resume/resume';

const BASE = import.meta.env.BASE_URL;
const formatMonth = (date: string) => date.replace('-', '.');
const { projectGroups, projectCount, projectYearsLabel, lastUpdated } = await getResume();
---

<Layout
  title="경력기술서 · 권오승"
  description="프론트엔드 개발자 권오승의 경력기술서. 패스오더에서 진행한 서비스 개발, 백오피스, 개발 플랫폼과 웹 인프라 프로젝트를 정리했습니다."
  wide
  profile
  noBackdrop
  compactHeader
>
  <article class="resume-page">
    <ResumeHeader />
    <CareerIntroduction />
    <CareerOverview />

    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-title">
        <div class="section-heading">
          <h2 id="projects-title">패스오더 주요 프로젝트</h2>
          <span class="section-meta">
            {projectCount}개 · {projectYearsLabel}
          </span>
        </div>

        <button class="project-expand-all" type="button" aria-controls="project-list" aria-expanded="false" data-project-expand-all data-print-hidden>
          <span data-project-expand-label>전체 펼치기</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="m4 6 4 4 4-4"></path>
          </svg>
        </button>
      </div>

      <div class="project-year-list" id="project-list">
        {
          projectGroups.map(({ year, projects: yearProjects }) => (
            <section class="project-year-group" aria-labelledby={`project-year-${year}`}>
              <header class="project-year-heading">
                <h3 id={`project-year-${year}`}>{year}</h3>
                <span>{yearProjects.length}개 프로젝트</span>
              </header>

              <div class="project-stack">
                {yearProjects.map(({ id, data, Content, projectIndex }) => (
                  <details class="project-entry surface" id={`project-${id}`}>
                    <summary class="project-summary">
                      <div class="project-summary-main">
                        <span class="print-project-index" aria-hidden="true">
                          프로젝트 {String(projectIndex + 1).padStart(2, '0')}
                        </span>
                        <div class="project-summary-header">
                          <div class="project-title-row">
                            <h4>{data.title}</h4>
                            <time datetime={`${data.startDate}/${data.endDate}`}>
                              {formatMonth(data.startDate)} — {formatMonth(data.endDate)}
                            </time>
                          </div>

                          <span class="project-toggle" aria-hidden="true">
                            <span class="project-toggle-open">펼치기</span>
                            <span class="project-toggle-close">접기</span>
                            <svg viewBox="0 0 16 16">
                              <path d="m4 6 4 4 4-4" />
                            </svg>
                          </span>
                        </div>
                        <div class="project-summary-lead">
                          <p>{data.summary}</p>
                          {data.links.length > 0 && (
                            <ul class="project-proof-list" aria-label="프로젝트 링크">
                              {data.links.map((link) => (
                                <li>
                                  <a
                                    class="project-proof-link"
                                    href={link.external ? link.href : `${BASE}${link.href}`}
                                    target={link.external ? '_blank' : undefined}
                                    rel={link.external ? 'noopener noreferrer' : undefined}
                                    aria-label={`${link.type}: ${link.label}`}
                                    title={link.label}
                                  >
                                    {link.type} <span aria-hidden="true">↗</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                        <dl class="project-facts">
                          <ResumeMetaRow label="성과">
                            <strong>{data.change.impact}</strong>
                          </ResumeMetaRow>
                          <ResumeMetaRow label="기술">
                            <ul class="technology-list" aria-label="사용 기술">
                              {data.technologies.map((technology) => (
                                <li>{technology}</li>
                              ))}
                            </ul>
                          </ResumeMetaRow>
                        </dl>
                      </div>
                    </summary>

                    <article class="project-detail">
                      <dl class="project-role">
                        <ResumeMetaRow label="핵심 업무" variant="role">
                          {data.roles.join(' · ')}
                        </ResumeMetaRow>
                      </dl>

                      <section class="project-change" aria-label="프로젝트 변화 요약">
                        <div class="diff-line diff-delete">
                          <span class="diff-sign" aria-hidden="true">
                            −
                          </span>
                          <small>before</small>
                          <strong>{data.change.before}</strong>
                        </div>
                        <div class="diff-line diff-add">
                          <span class="diff-sign" aria-hidden="true">
                            +
                          </span>
                          <small>after</small>
                          <strong>{data.change.after}</strong>
                        </div>
                      </section>

                      <div class="project-content">
                        <Content />
                      </div>
                    </article>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <ResumeFooter lastUpdated={lastUpdated} />
  </article>
</Layout>

<style>
  .resume-page {
    width: 100%;
    max-width: 55rem;
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
    --resume-rule: var(--color-border-secondary);
    --diff-delete-bg: #ffebe9;
    --diff-delete-gutter: #ffd7d5;
    --diff-delete-text: #82071e;
    --diff-add-bg: #dafbe1;
    --diff-add-gutter: #aceebb;
    --diff-add-text: #116329;
  }

  :global(.dark) .resume-page {
    --diff-delete-bg: #3f1d1d;
    --diff-delete-gutter: #602020;
    --diff-delete-text: #ffb3ad;
    --diff-add-bg: #1b3a2a;
    --diff-add-gutter: #235d38;
    --diff-add-text: #7ee2a8;
  }

  .project-proof-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .project-summary:focus-visible {
    outline: none;
  }

  .project-summary:focus-visible .project-toggle {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .projects-section {
    margin-top: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 0.5rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .section-title h2 {
    font-size: 1.25rem;
    font-weight: 720;
    letter-spacing: -0.015em;
  }

  .section-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-date);
  }

  .project-expand-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.1rem;
    padding-inline: 0.8rem;
    border: 1px solid var(--resume-rule);
    border-radius: 999px;
    background: var(--surface-bg);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 650;
    cursor: pointer;
  }

  .project-expand-all:hover {
    border-color: color-mix(in srgb, var(--color-text-primary) 24%, var(--resume-rule));
    color: var(--color-text-primary);
  }

  .project-expand-all:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-text-primary) 48%, transparent);
    outline-offset: 2px;
  }

  .project-expand-all svg {
    width: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }

  .project-expand-all[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .project-year-list {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .project-year-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.5rem 0.65rem;
    border-bottom: 1px solid var(--resume-rule);
  }

  .project-year-heading h3 {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  .project-year-heading span {
    font-size: 0.75rem;
    color: var(--color-text-date);
  }

  .project-stack {
    display: grid;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  .project-entry {
    overflow: clip;
    border-radius: 1.2rem;
    interpolate-size: allow-keywords;
    transition: border-color 160ms ease;
  }

  .project-entry::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 280ms cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 280ms allow-discrete;
  }

  .project-entry[open]::details-content {
    block-size: auto;
  }

  .project-summary {
    display: block;
    padding: 1.75rem 2rem;
    cursor: pointer;
    list-style: none;
    transition: color 160ms ease;
  }

  .project-summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .project-summary:hover .project-toggle {
      color: var(--color-text-primary);
    }
  }

  .project-summary-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
  }

  .project-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
  }

  .project-title-row time {
    padding-left: 0.9rem;
    border-left: 1px solid var(--resume-rule);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-text-date);
    white-space: nowrap;
  }

  .project-summary-main h4 {
    font-size: 1.3rem;
    font-weight: 720;
    line-height: 1.35;
    letter-spacing: -0.025em;
    word-break: keep-all;
  }

  .print-project-index {
    display: none;
  }

  .project-summary-lead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.85rem;
    margin-top: 0.45rem;
  }

  .project-summary-lead > p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .project-proof-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .project-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.76rem;
    font-weight: 680;
    line-height: 1.5;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .project-proof-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .project-facts {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--resume-rule);
  }

  .project-facts :global(dd > strong) {
    font-size: 0.9375rem;
    font-weight: 620;
    line-height: 1.6;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
  }

  .technology-list li {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--resume-rule);
    border-radius: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 620;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .project-toggle {
    display: inline-flex;
    align-self: start;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: auto;
    min-height: 2rem;
    padding-inline: 0.15rem;
    border: 0;
    font-size: 0.75rem;
    font-weight: 680;
    line-height: 1;
    color: var(--color-text-date);
    white-space: nowrap;
  }

  .project-toggle svg {
    width: 0.72rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }

  .project-toggle-close {
    display: none;
  }

  .project-entry[open] .project-toggle-open {
    display: none;
  }

  .project-entry[open] .project-toggle-close {
    display: inline;
  }

  .project-entry[open] .project-toggle {
    color: var(--color-text-primary);
  }

  .project-entry[open] .project-toggle svg {
    transform: rotate(180deg);
  }

  .project-detail {
    margin: 0;
    padding: 1.5rem 2.5rem 2rem;
    border-top: 1px solid var(--resume-rule);
    opacity: 0;
    transform: translateY(-0.4rem);
    transition:
      opacity 200ms ease 60ms,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1) 40ms;
  }

  .project-entry[open] .project-detail {
    opacity: 1;
    transform: translateY(0);
  }

  .project-role {
    margin: 0;
  }

  .project-change {
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--resume-rule);
    border-radius: 0.35rem;
    background: var(--surface-bg);
  }

  .diff-line {
    display: grid;
    grid-template-columns: 2rem 4.25rem minmax(0, 1fr);
    align-items: center;
    min-height: 3rem;
    padding-inline: 0.85rem;
  }

  .diff-line + .diff-line {
    border-top: 1px solid var(--resume-rule);
  }

  .diff-delete {
    background: transparent;
    box-shadow: inset 2px 0 var(--diff-delete-text);
  }

  .diff-add {
    background: transparent;
    box-shadow: inset 2px 0 var(--diff-add-text);
  }

  .diff-sign {
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .diff-delete .diff-sign {
    color: var(--diff-delete-text);
  }

  .diff-add .diff-sign {
    color: var(--diff-add-text);
  }

  .diff-line small {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .diff-delete small,
  .diff-delete strong {
    color: var(--diff-delete-text);
  }

  .diff-add small,
  .diff-add strong {
    color: var(--diff-add-text);
  }

  .diff-line strong {
    padding: 0.65rem 0.5rem 0.65rem 0;
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.45;
    word-break: keep-all;
  }

  .project-content {
    margin-top: 2rem;
  }

  .project-content :global(h2:not(:first-child)) {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--resume-rule);
  }

  .project-content :global(h2) {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .project-content :global(p) {
    margin-top: 0.85rem;
    font-size: 1.0625rem;
    font-weight: 450;
    line-height: 1.8;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .project-content :global(p + p) {
    margin-top: 0.9rem;
  }

  .project-content :global(strong) {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (max-width: 680px) {
    .resume-page {
      padding-top: 2.5rem;
    }

    .projects-section {
      margin-top: 2.5rem;
    }

    .section-title {
      align-items: stretch;
      flex-direction: column;
      gap: 0.8rem;
    }

    .section-heading {
      justify-content: space-between;
    }

    .project-expand-all {
      align-self: flex-end;
    }

    .project-year-list {
      gap: 1.6rem;
    }

    .project-summary {
      padding: 1.25rem;
    }

    .project-summary-header {
      gap: 0.9rem;
    }

    .project-title-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .project-title-row time {
      padding-left: 0;
      border-left: 0;
    }

    .project-summary-lead {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .project-detail {
      margin: 0;
      padding: 1.25rem 1.25rem 1.5rem;
    }

    .diff-line {
      grid-template-columns: 1.75rem 3.75rem minmax(0, 1fr);
      padding-inline: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-entry,
    .project-summary,
    .project-expand-all svg,
    .project-toggle svg,
    .project-detail,
    .project-entry::details-content {
      transition: none;
    }
  }

  @media print {
    :global(html) {
      color-scheme: light;
      font-size: 9.5pt;
    }

    :global(body),
    :global(html.dark body) {
      background: white !important;
      color: #0a0c10 !important;
    }

    :global(body::before),
    :global(body > header),
    :global(body > footer),
    :global(#reading-progress),
    [data-print-hidden] {
      display: none !important;
    }

    :global(main) {
      max-width: none !important;
      padding: 0 !important;
    }

    .resume-page {
      --color-text-primary: #0a0c10;
      --color-text-secondary: #3f454e;
      --color-text-date: #707782;
      --color-accent: #006fff;
      --color-border-secondary: #d8dde5;
      --surface-bg: #ffffff;
      --surface-border: #d8dde5;
      --surface-shadow: none;
      --diff-delete-bg: #ffebe9;
      --diff-delete-gutter: #ffd7d5;
      --diff-delete-text: #82071e;
      --diff-add-bg: #dafbe1;
      --diff-add-gutter: #aceebb;
      --diff-add-text: #116329;
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .projects-section {
      margin-top: 7mm;
    }

    .section-title {
      padding: 0 0 3mm;
    }

    .section-title h2 {
      font-size: 12pt;
    }

    .section-meta {
      font-size: 7pt;
    }

    .project-year-list {
      display: block;
      margin-top: 8mm;
    }

    .project-year-heading {
      display: none;
    }

    .project-stack {
      display: block;
      margin-top: 0;
    }

    .project-entry {
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      break-inside: auto;
    }

    .project-entry::details-content {
      block-size: auto !important;
      overflow: visible;
      content-visibility: visible;
    }

    .project-entry + .project-entry {
      margin-top: 9mm;
    }

    .project-year-group:not(:first-child) .project-entry:first-child {
      margin-top: 9mm;
    }

    .project-summary {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 4mm 0 5mm;
      border-top: 2px solid var(--color-text-primary);
      border-bottom: 1px solid var(--resume-rule);
    }

    .print-project-index {
      display: block;
      margin-bottom: 2.5mm;
      font-family: var(--font-mono);
      font-size: 6.5pt;
      font-weight: 650;
      letter-spacing: 0.1em;
      color: var(--color-text-date);
    }

    .project-title-row {
      justify-content: space-between;
      gap: 4mm;
    }

    .project-summary-main h4 {
      font-size: 16pt;
      line-height: 1.25;
      color: var(--color-text-primary) !important;
    }

    .project-title-row time {
      padding: 0;
      border: 0;
      font-size: 7.5pt;
    }

    .project-summary-lead {
      margin-top: 2mm;
      gap: 2mm;
    }

    .project-summary-lead > p {
      font-size: 9pt;
      line-height: 1.55;
    }

    .project-proof-link {
      font-size: 7.5pt;
    }

    .project-facts {
      gap: 2.5mm;
      margin-top: 4mm;
      padding-top: 4mm;
    }

    .project-facts :global(dd > strong) {
      font-size: 8.5pt;
    }

    .technology-list {
      gap: 0;
    }

    .technology-list li {
      padding: 0;
      border: 0;
      border-radius: 0;
      font-size: 7.5pt;
    }

    .technology-list li:not(:last-child)::after {
      content: '·';
      margin-inline: 2mm;
      color: var(--color-text-date);
    }

    .project-toggle {
      display: none;
    }

    .project-detail {
      display: block !important;
      margin: 0;
      padding: 5mm 0 0;
      border-top: 0;
      opacity: 1;
      transform: none;
      box-shadow: none;
    }

    .project-summary,
    .project-change,
    .project-content :global(h2) {
      break-inside: avoid;
    }

    .project-change {
      margin-top: 5mm;
      border-radius: 1mm;
    }

    .project-content {
      margin-top: 6mm;
    }

    .project-content :global(h2:not(:first-child)) {
      margin-top: 5mm;
      padding-top: 0;
      border-top: 0;
    }

    .project-content :global(h2:not(:first-child))::before {
      content: '';
      display: block;
      width: 10mm;
      height: 1px;
      margin-bottom: 5mm;
      background: var(--resume-rule);
    }

    .project-content :global(h2) {
      font-size: 11pt;
      break-after: avoid-page;
    }

    .project-content :global(p) {
      margin-top: 2mm;
      font-size: 8.7pt;
      line-height: 1.68;
      orphans: 3;
      widows: 3;
    }

    @page {
      size: A4;
      margin: 14mm 15mm;
    }
  }
</style>

<script>
  const projectEntries = Array.from(document.querySelectorAll<HTMLDetailsElement>('.project-entry'));
  const projectExpandAll = document.querySelector<HTMLButtonElement>('[data-project-expand-all]');
  const projectExpandLabel = document.querySelector<HTMLElement>('[data-project-expand-label]');
  let projectOpenStates: boolean[] = [];

  const syncProjectExpandAll = () => {
    const allOpen = projectEntries.length > 0 && projectEntries.every((project) => project.open);

    projectExpandAll?.setAttribute('aria-expanded', String(allOpen));
    if (projectExpandLabel) {
      projectExpandLabel.textContent = allOpen ? '전체 접기' : '전체 펼치기';
    }
  };

  projectExpandAll?.addEventListener('click', () => {
    const shouldOpen = !projectEntries.every((project) => project.open);
    projectEntries.forEach((project) => {
      project.open = shouldOpen;
    });
    syncProjectExpandAll();
  });

  projectEntries.forEach((project) => {
    project.addEventListener('toggle', syncProjectExpandAll);
  });

  document.querySelectorAll<HTMLAnchorElement>('.project-proof-link').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.stopPropagation();
    });
  });

  const openLinkedProject = () => {
    if (!window.location.hash) return;

    const linkedProject = document.querySelector<HTMLDetailsElement>(window.location.hash);

    if (linkedProject?.classList.contains('project-entry')) {
      linkedProject.open = true;
    }
  };

  window.addEventListener('hashchange', openLinkedProject);
  window.addEventListener('beforeprint', () => {
    projectOpenStates = projectEntries.map((project) => project.open);
    projectEntries.forEach((project) => {
      project.open = true;
    });
  });
  window.addEventListener('afterprint', () => {
    projectEntries.forEach((project, index) => {
      project.open = projectOpenStates[index] ?? false;
    });
  });

  openLinkedProject();
  syncProjectExpandAll();
</script>
