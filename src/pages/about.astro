---
import Layout from '../layouts/Layout.astro';
import CareerIntroduction from '../features/resume/CareerIntroduction.astro';
import CareerOverview from '../features/resume/CareerOverview.astro';
import ProjectTimeline from '../features/resume/ProjectTimeline.astro';
import ResumeFooter from '../features/resume/ResumeFooter.astro';
import ResumeHeader from '../features/resume/ResumeHeader.astro';
import { getResume } from '../features/resume/resume';

const { projectGroups, projectCount, projectYearsLabel, lastUpdated } = await getResume();
---

<Layout
  title="경력기술서 · 권오승"
  description="프론트엔드 개발자 권오승의 경력기술서. 패스오더에서 진행한 서비스 개발, 백오피스, 개발 플랫폼과 웹 인프라 프로젝트를 정리했습니다."
  wide
  profile
  noBackdrop
  compactHeader
>
  <article class="resume-page">
    <ResumeHeader />
    <CareerIntroduction />
    <CareerOverview />
    <ProjectTimeline groups={projectGroups} projectCount={projectCount} yearsLabel={projectYearsLabel} />
    <ResumeFooter lastUpdated={lastUpdated} />
  </article>
</Layout>

<style>
  .resume-page {
    width: 100%;
    max-width: 55rem;
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
    --resume-rule: var(--color-border-secondary);
    --diff-delete-bg: #ffebe9;
    --diff-delete-gutter: #ffd7d5;
    --diff-delete-text: #82071e;
    --diff-add-bg: #dafbe1;
    --diff-add-gutter: #aceebb;
    --diff-add-text: #116329;
  }

  :global(.dark) .resume-page {
    --diff-delete-bg: #3f1d1d;
    --diff-delete-gutter: #602020;
    --diff-delete-text: #ffb3ad;
    --diff-add-bg: #1b3a2a;
    --diff-add-gutter: #235d38;
    --diff-add-text: #7ee2a8;
  }

  @media (max-width: 680px) {
    .resume-page {
      padding-top: 2.5rem;
    }
  }

  @media print {
    :global(html) {
      color-scheme: light;
      font-size: 9.5pt;
    }

    :global(body),
    :global(html.dark body) {
      background: white !important;
      color: #0a0c10 !important;
    }

    :global(body::before),
    :global(body > header),
    :global(body > footer),
    :global(#reading-progress) {
      display: none !important;
    }

    :global(main) {
      max-width: none !important;
      padding: 0 !important;
    }

    .resume-page {
      --color-text-primary: #0a0c10;
      --color-text-secondary: #3f454e;
      --color-text-date: #707782;
      --color-accent: #006fff;
      --color-border-secondary: #d8dde5;
      --surface-bg: #ffffff;
      --surface-border: #d8dde5;
      --surface-shadow: none;
      --diff-delete-bg: #ffebe9;
      --diff-delete-gutter: #ffd7d5;
      --diff-delete-text: #82071e;
      --diff-add-bg: #dafbe1;
      --diff-add-gutter: #aceebb;
      --diff-add-text: #116329;
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    @page {
      size: A4;
      margin: 14mm 15mm;
    }
  }
</style>
