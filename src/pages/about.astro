</style>

<script>
  const projectEntries = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.project-entry'),
  );
  const projectExpandAll = document.querySelector<HTMLButtonElement>(
    '[data-project-expand-all]',
  );
  const projectExpandLabel = document.querySelector<HTMLElement>(
    '[data-project-expand-label]',
  );
  let projectOpenStates: boolean[] = [];

  const syncProjectExpandAll = () => {
    const allOpen =
      projectEntries.length > 0 &&
      projectEntries.every((project) => project.open);

    projectExpandAll?.setAttribute('aria-expanded', String(allOpen));
    if (projectExpandLabel) {
      projectExpandLabel.textContent = allOpen ? '전체 접기' : '전체 펼치기';
    }
  };

  projectExpandAll?.addEventListener('click', () => {
    const shouldOpen = !projectEntries.every((project) => project.open);
    projectEntries.forEach((project) => {
      project.open = shouldOpen;
    });
    syncProjectExpandAll();
  });

  projectEntries.forEach((project) => {
    project.addEventListener('toggle', syncProjectExpandAll);
  });

  document
    .querySelectorAll<HTMLAnchorElement>('.project-proof-link')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        event.stopPropagation();
      });
    });

  const openLinkedProject = () => {
    if (!window.location.hash) return;

    const linkedProject = document.querySelector<HTMLDetailsElement>(
      window.location.hash,
    );

    if (linkedProject?.classList.contains('project-entry')) {
      linkedProject.open = true;
    }
  };

  document
    .querySelector('[data-print-resume]')
    ?.addEventListener('click', () => {
      window.print();
    });

  window.addEventListener('hashchange', openLinkedProject);
  window.addEventListener('beforeprint', () => {
    projectOpenStates = projectEntries.map((project) => project.open);
    projectEntries.forEach((project) => {
      project.open = true;
    });
  });
  window.addEventListener('afterprint', () => {
    projectEntries.forEach((project, index) => {
      project.open = projectOpenStates[index] ?? false;
    });
  });

  openLinkedProject();
  syncProjectExpandAll();
</script>
