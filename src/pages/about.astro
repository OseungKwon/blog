---
import Layout from '../layouts/Layout.astro';
import ResumeMetaRow from '../components/ResumeMetaRow.astro';
import { getResume } from '../features/resume/resume';

const BASE = import.meta.env.BASE_URL;
const formatMonth = (date: string) => date.replace('-', '.');
const { projectGroups, projectCount, projectYearsLabel, lastUpdated } = await getResume();
---

<Layout
  title="경력기술서 · 권오승"
  description="프론트엔드 개발자 권오승의 경력기술서. 패스오더에서 진행한 서비스 개발, 백오피스, 개발 플랫폼과 웹 인프라 프로젝트를 정리했습니다."
  wide
  profile
  noBackdrop
  compactHeader
>
  <article class="resume-page">
    <header class="resume-header">
      <div class="identity">
        <p>Frontend Engineer</p>
        <h1>권오승</h1>
      </div>

      <div class="contact-list" aria-label="연락처">
        <a href="mailto:00osos@naver.com">
          <span class="contact-label">Email</span>
          <span>00osos@naver.com</span>
        </a>
        <a href="https://github.com/oseungkwon" target="_blank" rel="noopener noreferrer">
          <span class="contact-label">GitHub</span>
          <span>github.com/oseungkwon</span>
        </a>
        <a href={BASE}>
          <span class="contact-label">Blog</span>
          <span>오승의 기술블로그</span>
        </a>
      </div>

      <button class="print-button press" type="button" data-print-resume data-print-hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"></path>
        </svg>
        PDF로 저장
      </button>
    </header>

    <section class="career-introduction" aria-labelledby="career-introduction-title">
      <h2 id="career-introduction-title">
        PM처럼 제품의 목적을 끝까지 파고들고,<br />
        디자이너처럼 작은 차이를 놓치지 않는 프론트엔드 개발자 권오승입니다.
      </h2>

      <div class="career-introduction-copy">
        <p>
          기획서를 받으면 구현할 기능부터 확인하기보다,
          <strong>사용자가 어떤 흐름을 거쳐 이 기능을 이용하게 될지</strong>
          먼저 살펴봅니다. 사용자 흐름 속에서 개선할 만한 부분이 보이면 개선안을 제안하고, 디자이너와 소통하며 화면에 담긴 의도와 맥락까지 이해한 뒤 설계에 들어갑니다.
        </p>
        <p>
          프로젝트의 전 과정에 참여하면서 요구사항은 언제든 달라질 수 있다는 점을 경험했고, <strong>변화에 유연하게 대응할 수 있는 개발 구조</strong>가 필요하다고 느꼈습니다. 기획이나 디자인이 바뀔
          때마다 코드 곳곳을 수정하는 문제를 줄이기 위해 <strong>함수형 프로그래밍과 클린 아키텍처, FSD</strong>를 공부했습니다. 이를 반영한 구조를 팀에 제안해 실제 프로젝트에 적용했고, 현재는 전사 웹
          프로젝트의 공통 개발 방식으로 사용하고 있습니다.
        </p>
        <p>
          경험이 쌓이면서 제가 작성하는 코드뿐 아니라
          <strong>팀이 반복해서 겪는 불편</strong>에도 관심을 갖게 됐습니다. 프로젝트마다 다시 만들던 UI를 <strong>디자인 시스템</strong>으로 정리하고, 화면 곳곳에 흩어져 있던 이벤트 로직은 <strong
            >선언형 트래킹 라이브러리</strong
          >로 통합했습니다. 최근에는 n8n을 사용해 업무를 자동화하고, 프로젝트에서 정한 개발 방식과 품질 기준을 따르도록 <strong>AI 워크플로우</strong>를 구축해 작업 시간과 시행착오를 줄였습니다.
        </p>
        <p>
          "저는 그동안
          <strong>웹 주문과 결제, 상품권, 적립, 사장님 페이지, 디자인 시스템 등 회사의 주요 프로젝트</strong>
          를 맡아 진행했습니다. 현재는 Next.js 기반 서비스 개발을 중심으로 업무를 진행하고 있으며,
          <strong>모니터링 시스템 구축과 CI/CD 최적화, 웹 서버 운영</strong>
          까지 담당하며 제품의 개발부터 운영까지 함께하고 있습니다."
        </p>
      </div>
    </section>

    <dl class="career-overview" aria-label="경력 요약">
      <div>
        <dt>회사</dt>
        <dd>패스오더</dd>
      </div>
      <div>
        <dt>경력</dt>
        <dd>Frontend Engineer · 4년</dd>
      </div>
      <div class="career-focus">
        <dt>주요 영역</dt>
        <dd>주문·결제 · 상품권 · 적립 · 백오피스 · 이벤트</dd>
      </div>
    </dl>

    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-title">
        <div class="section-heading">
          <h2 id="projects-title">패스오더 주요 프로젝트</h2>
          <span class="section-meta">
            {projectCount}개 · {projectYearsLabel}
          </span>
        </div>

        <button class="project-expand-all" type="button" aria-controls="project-list" aria-expanded="false" data-project-expand-all data-print-hidden>
          <span data-project-expand-label>전체 펼치기</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="m4 6 4 4 4-4"></path>
          </svg>
        </button>
      </div>

      <div class="project-year-list" id="project-list">
        {
          projectGroups.map(({ year, projects: yearProjects }) => (
            <section class="project-year-group" aria-labelledby={`project-year-${year}`}>
              <header class="project-year-heading">
                <h3 id={`project-year-${year}`}>{year}</h3>
                <span>{yearProjects.length}개 프로젝트</span>
              </header>

              <div class="project-stack">
                {yearProjects.map(({ id, data, Content, projectIndex }) => (
                  <details class="project-entry surface" id={`project-${id}`}>
                    <summary class="project-summary">
                      <div class="project-summary-main">
                        <span class="print-project-index" aria-hidden="true">
                          프로젝트 {String(projectIndex + 1).padStart(2, '0')}
                        </span>
                        <div class="project-summary-header">
                          <div class="project-title-row">
                            <h4>{data.title}</h4>
                            <time datetime={`${data.startDate}/${data.endDate}`}>
                              {formatMonth(data.startDate)} — {formatMonth(data.endDate)}
                            </time>
                          </div>

                          <span class="project-toggle" aria-hidden="true">
                            <span class="project-toggle-open">펼치기</span>
                            <span class="project-toggle-close">접기</span>
                            <svg viewBox="0 0 16 16">
                              <path d="m4 6 4 4 4-4" />
                            </svg>
                          </span>
                        </div>
                        <div class="project-summary-lead">
                          <p>{data.summary}</p>
                          {data.links.length > 0 && (
                            <ul class="project-proof-list" aria-label="프로젝트 링크">
                              {data.links.map((link) => (
                                <li>
                                  <a
                                    class="project-proof-link"
                                    href={link.external ? link.href : `${BASE}${link.href}`}
                                    target={link.external ? '_blank' : undefined}
                                    rel={link.external ? 'noopener noreferrer' : undefined}
                                    aria-label={`${link.type}: ${link.label}`}
                                    title={link.label}
                                  >
                                    {link.type} <span aria-hidden="true">↗</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                        <dl class="project-facts">
                          <ResumeMetaRow label="성과">
                            <strong>{data.change.impact}</strong>
                          </ResumeMetaRow>
                          <ResumeMetaRow label="기술">
                            <ul class="technology-list" aria-label="사용 기술">
                              {data.technologies.map((technology) => (
                                <li>{technology}</li>
                              ))}
                            </ul>
                          </ResumeMetaRow>
                        </dl>
                      </div>
                    </summary>

                    <article class="project-detail">
                      <dl class="project-role">
                        <ResumeMetaRow label="핵심 업무" variant="role">
                          {data.roles.join(' · ')}
                        </ResumeMetaRow>
                      </dl>

                      <section class="project-change" aria-label="프로젝트 변화 요약">
                        <div class="diff-line diff-delete">
                          <span class="diff-sign" aria-hidden="true">
                            −
                          </span>
                          <small>before</small>
                          <strong>{data.change.before}</strong>
                        </div>
                        <div class="diff-line diff-add">
                          <span class="diff-sign" aria-hidden="true">
                            +
                          </span>
                          <small>after</small>
                          <strong>{data.change.after}</strong>
                        </div>
                      </section>

                      <div class="project-content">
                        <Content />
                      </div>
                    </article>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <footer class="resume-footer">
      <span>권오승 · Frontend Engineer</span>
      <span>Updated {formatMonth(lastUpdated)}</span>
    </footer>
  </article>
</Layout>

<style>
  .resume-page {
    width: 100%;
    max-width: 55rem;
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
    --resume-rule: var(--color-border-secondary);
    --diff-delete-bg: #ffebe9;
    --diff-delete-gutter: #ffd7d5;
    --diff-delete-text: #82071e;
    --diff-add-bg: #dafbe1;
    --diff-add-gutter: #aceebb;
    --diff-add-text: #116329;
  }

  :global(.dark) .resume-page {
    --diff-delete-bg: #3f1d1d;
    --diff-delete-gutter: #602020;
    --diff-delete-text: #ffb3ad;
    --diff-add-bg: #1b3a2a;
    --diff-add-gutter: #235d38;
    --diff-add-text: #7ee2a8;
  }

  .resume-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.1rem 2rem;
    align-items: end;
    padding: 0 0.5rem 2rem;
    border-bottom: 1px solid var(--resume-rule);
  }

  .identity > p {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-date);
  }

  .identity h1 {
    margin-top: 0.45rem;
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 730;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .contact-list {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.5rem;
    align-items: center;
  }

  .contact-list a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: baseline;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-date);
    text-transform: uppercase;
  }

  .contact-list a:hover {
    color: var(--color-accent);
  }

  .career-introduction {
    margin: 1.5rem 0.5rem 0;
  }

  .career-introduction h2 {
    max-width: 47rem;
    font-size: clamp(1.35rem, 2.4vw, 1.625rem);
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .career-introduction-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    max-width: 52rem;
    margin-top: 1rem;
  }

  .career-introduction-copy p {
    font-size: 1.0625rem;
    font-weight: 450;
    line-height: 1.8;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .career-introduction-copy strong {
    font-weight: 650;
  }

  .print-button {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0 0.85rem;
    border: 1px solid var(--resume-rule);
    border-radius: 999px;
    background: var(--surface-bg);
    color: var(--color-text-primary);
    font-size: 0.78rem;
    font-weight: 650;
    cursor: pointer;
  }

  .print-button svg {
    width: 0.9rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .print-button:focus-visible,
  .contact-list a:focus-visible,
  .project-proof-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .career-overview {
    display: grid;
    grid-template-columns: 0.7fr 1.15fr 2fr;
    margin: 1rem 0.5rem 0;
    padding: 1rem 0;
    border-bottom: 1px solid var(--resume-rule);
  }

  .career-overview > div {
    min-width: 0;
    padding-inline: 1rem;
  }

  .career-overview > div:first-child {
    padding-left: 0;
  }

  .career-overview > div + div {
    border-left: 1px solid var(--resume-rule);
  }

  .career-overview dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-date);
  }

  .career-overview dd {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.5;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .project-summary:focus-visible {
    outline: none;
  }

  .project-summary:focus-visible .project-toggle {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .projects-section {
    margin-top: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 0.5rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .section-title h2 {
    font-size: 1.25rem;
    font-weight: 720;
    letter-spacing: -0.015em;
  }

  .section-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-date);
  }

  .project-expand-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.1rem;
    padding-inline: 0.8rem;
    border: 1px solid var(--resume-rule);
    border-radius: 999px;
    background: var(--surface-bg);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 650;
    cursor: pointer;
  }

  .project-expand-all:hover {
    border-color: color-mix(in srgb, var(--color-text-primary) 24%, var(--resume-rule));
    color: var(--color-text-primary);
  }

  .project-expand-all:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-text-primary) 48%, transparent);
    outline-offset: 2px;
  }

  .project-expand-all svg {
    width: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }

  .project-expand-all[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .project-year-list {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .project-year-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.5rem 0.65rem;
    border-bottom: 1px solid var(--resume-rule);
  }

  .project-year-heading h3 {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  .project-year-heading span {
    font-size: 0.75rem;
    color: var(--color-text-date);
  }

  .project-stack {
    display: grid;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  .project-entry {
    overflow: clip;
    border-radius: 1.2rem;
    interpolate-size: allow-keywords;
    transition: border-color 160ms ease;
  }

  .project-entry::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 280ms cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 280ms allow-discrete;
  }

  .project-entry[open]::details-content {
    block-size: auto;
  }

  .project-summary {
    display: block;
    padding: 1.75rem 2rem;
    cursor: pointer;
    list-style: none;
    transition: color 160ms ease;
  }

  .project-summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .project-summary:hover .project-toggle {
      color: var(--color-text-primary);
    }
  }

  .project-summary-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
  }

  .project-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
  }

  .project-title-row time {
    padding-left: 0.9rem;
    border-left: 1px solid var(--resume-rule);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-text-date);
    white-space: nowrap;
  }

  .project-summary-main h4 {
    font-size: 1.3rem;
    font-weight: 720;
    line-height: 1.35;
    letter-spacing: -0.025em;
    word-break: keep-all;
  }

  .print-project-index {
    display: none;
  }

  .project-summary-lead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.85rem;
    margin-top: 0.45rem;
  }

  .project-summary-lead > p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .project-proof-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .project-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.76rem;
    font-weight: 680;
    line-height: 1.5;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .project-proof-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .project-facts {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--resume-rule);
  }

  .project-facts :global(dd > strong) {
    font-size: 0.9375rem;
    font-weight: 620;
    line-height: 1.6;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
  }

  .technology-list li {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--resume-rule);
    border-radius: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 620;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .project-toggle {
    display: inline-flex;
    align-self: start;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: auto;
    min-height: 2rem;
    padding-inline: 0.15rem;
    border: 0;
    font-size: 0.75rem;
    font-weight: 680;
    line-height: 1;
    color: var(--color-text-date);
    white-space: nowrap;
