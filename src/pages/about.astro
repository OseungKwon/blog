---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const BASE = import.meta.env.BASE_URL;
const formatMonth = (date: string) => date.replace('-', '.');
const projects = await Promise.all(
  (await getCollection('career'))
    .sort(
      (a, b) =>
        b.data.endDate.localeCompare(a.data.endDate) ||
        a.data.order - b.data.order,
    )
    .map(async (project) => ({
      ...project,
      Content: (await project.render()).Content,
    })),
);
const projectYears = [
  ...new Set(
    projects.flatMap(({ data }) => [
      data.startDate.slice(0, 4),
      data.endDate.slice(0, 4),
    ]),
  ),
].sort();
const projectYearsLabel =
  projectYears.length > 1
    ? `${projectYears[0]}—${projectYears.at(-1)}`
    : (projectYears[0] ?? '');
const lastUpdated = projects.reduce(
  (latest, { data }) => (data.endDate > latest ? data.endDate : latest),
  '',
);
---

<Layout
  title="경력기술서 · 권오승"
  description="프론트엔드 개발자 권오승의 경력기술서. AI 개발 워크플로우와 웹 주문·결제 시스템 구축 경험을 정리했습니다."
  wide
  profile
>
  <article class="resume-page">
    <header class="resume-header">
      <div class="identity">
        <p>Frontend Engineer</p>
        <h1>권오승</h1>
      </div>

      <div class="contact-list">
        <a href="mailto:00osos@naver.com">00osos@naver.com</a>
        <a
          href="https://github.com/oseungkwon"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/oseungkwon
        </a>
        <a href={BASE}>자몽의 기술블로그</a>
      </div>

      <button
        class="print-button press"
        type="button"
        data-print-resume
        data-print-hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"
          ></path>
        </svg>
        PDF로 저장
      </button>
    </header>

    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-title">
        <div class="section-heading">
          <h2 id="projects-title">패스오더 주요 프로젝트</h2>
          <span class="section-meta">
            프로젝트 {projects.length}개 · {projectYearsLabel}
          </span>
        </div>

        <div
          class="project-view-filter"
          role="group"
          aria-label="프로젝트 표시 방식"
          data-print-hidden
        >
          <button type="button" data-project-view="brief" aria-pressed="true">
            간략하게 보기
          </button>
          <button type="button" data-project-view="detail" aria-pressed="false">
            자세히 보기
          </button>
        </div>
      </div>

      <div class="project-stack">
        {
          projects.map(({ id, data, Content }, projectIndex) => (
            <details class="project-entry surface" id={`project-${id}`}>
              <summary class="project-summary">
                <div class="project-summary-main">
                  <span class="print-project-index" aria-hidden="true">
                    프로젝트 {String(projectIndex + 1).padStart(2, '0')}
                  </span>
                  <div class="project-title-row">
                    <h3>{data.title}</h3>
                    <time datetime={`${data.startDate}/${data.endDate}`}>
                      {formatMonth(data.startDate)} —{' '}
                      {formatMonth(data.endDate)}
                    </time>
                  </div>
                  <p>{data.summary}</p>
                  <dl class="project-facts">
                    <div>
                      <dt>성과</dt>
                      <dd>
                        <strong>{data.change.impact}</strong>
                      </dd>
                    </div>
                    <div>
                      <dt>기술</dt>
                      <dd>
                        <ul class="technology-list" aria-label="사용 기술">
                          {data.technologies.map((technology) => (
                            <li>{technology}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  </dl>
                </div>

                <span class="project-toggle" aria-hidden="true">
                  <span class="project-toggle-open">상세 보기</span>
                  <span class="project-toggle-close">접기</span>
                  <svg viewBox="0 0 16 16">
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                </span>
              </summary>

              <article class="project-detail">
                <p class="project-role">{data.roles.join(' · ')}</p>

                <section class="project-change" aria-label="프로젝트 변화 요약">
                  <div class="diff-line diff-delete">
                    <span class="diff-sign" aria-hidden="true">
                      −
                    </span>
                    <small>before</small>
                    <strong>{data.change.before}</strong>
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-sign" aria-hidden="true">
                      +
                    </span>
                    <small>after</small>
                    <strong>{data.change.after}</strong>
                  </div>
                  <p class="diff-impact">
                    <span>@@ impact @@</span>
                    <strong>{data.change.impact}</strong>
                  </p>
                </section>

                <div class="project-content">
                  <Content />
                </div>

                {data.links.length > 0 && (
                  <footer class="project-footer">
                    {data.links.map((link) => (
                      <div class="project-link-row">
                        <span>{link.type}</span>
                        <a
                          href={
                            link.external ? link.href : `${BASE}${link.href}`
                          }
                          target={link.external ? '_blank' : undefined}
                          rel={
                            link.external ? 'noopener noreferrer' : undefined
                          }
                        >
                          {link.label} <span aria-hidden="true">↗</span>
                        </a>
                      </div>
                    ))}
                  </footer>
                )}
              </article>
            </details>
          ))
        }
      </div>
    </section>

    <footer class="resume-footer">
      <span>권오승 · Frontend Engineer</span>
      <span>Updated {formatMonth(lastUpdated)}</span>
    </footer>
  </article>
</Layout>

<style>
  .resume-page {
    width: 100%;
    max-width: 55rem;
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
    --resume-rule: var(--color-border-secondary);
    --diff-delete-bg: #ffebe9;
    --diff-delete-gutter: #ffd7d5;
    --diff-delete-text: #82071e;
    --diff-add-bg: #dafbe1;
    --diff-add-gutter: #aceebb;
    --diff-add-text: #116329;
  }

  :global(.dark) .resume-page {
    --diff-delete-bg: #3f1d1d;
    --diff-delete-gutter: #602020;
    --diff-delete-text: #ffb3ad;
    --diff-add-bg: #1b3a2a;
    --diff-add-gutter: #235d38;
    --diff-add-text: #7ee2a8;
  }

  .resume-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 2rem;
    align-items: end;
    padding: 0 0.5rem 2rem;
    border-bottom: 1px solid var(--resume-rule);
  }

  .identity > p {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .identity h1 {
    margin-top: 0.45rem;
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 730;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .contact-list {
    display: grid;
    gap: 0.32rem;
    padding-bottom: 0.15rem;
    text-align: right;
  }

  .contact-list a {
    font-size: 0.73rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .contact-list a:hover {
    color: var(--color-accent);
  }

  .print-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0 0.85rem;
    border: 1px solid var(--resume-rule);
    border-radius: 999px;
    background: var(--surface-bg);
    color: var(--color-text-primary);
    font-size: 0.73rem;
    font-weight: 650;
    cursor: pointer;
  }

  .print-button svg {
    width: 0.9rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .print-button:focus-visible,
  .contact-list a:focus-visible,
  .project-footer a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .project-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -3px;
    border-radius: inherit;
  }

  .projects-section {
    margin-top: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 0.5rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .section-title h2 {
    font-size: 1.1rem;
    font-weight: 720;
    letter-spacing: -0.015em;
  }

  .section-meta {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-date);
  }

  .project-view-filter {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.2rem;
    border: 1px solid var(--resume-rule);
    border-radius: 0.7rem;
    background: var(--surface-bg);
  }

  .project-view-filter button {
    min-height: 1.9rem;
    padding-inline: 0.7rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    font-weight: 650;
    cursor: pointer;
  }

  .project-view-filter button[aria-pressed='true'] {
    background: var(--color-accent);
    color: white;
  }

  .project-view-filter button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .project-stack {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .project-entry {
    overflow: clip;
    border-radius: 1.2rem;
    interpolate-size: allow-keywords;
  }

  .project-entry::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 280ms cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 280ms allow-discrete;
  }

  .project-entry[open]::details-content {
    block-size: auto;
  }

  .project-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.75rem 2rem;
    cursor: pointer;
    list-style: none;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .project-summary::-webkit-details-marker {
    display: none;
  }

  .project-summary:hover {
    background: color-mix(in srgb, var(--color-accent) 3%, transparent);
  }

  .project-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
  }

  .project-title-row time {
    padding-left: 0.9rem;
    border-left: 1px solid var(--resume-rule);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-text-date);
    white-space: nowrap;
  }

  .project-summary-main h3 {
    font-size: 1.2rem;
    font-weight: 720;
    line-height: 1.35;
    letter-spacing: -0.025em;
    word-break: keep-all;
  }

  .print-project-index {
    display: none;
  }

  .project-summary-main > p {
    margin-top: 0.45rem;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .project-facts {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--resume-rule);
  }

  .project-facts > div {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }

  .project-facts dt {
    font-size: 0.72rem;
    font-weight: 720;
    line-height: 1.5;
    color: var(--color-accent);
  }

  .project-facts dd {
    min-width: 0;
  }

  .project-facts dd > strong {
    font-size: 0.82rem;
    font-weight: 680;
    line-height: 1.6;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
  }

  .technology-list li {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--resume-rule);
    border-radius: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 620;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .project-toggle {
    display: inline-flex;
    align-self: start;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 5.25rem;
    height: 2rem;
    padding-inline: 0.7rem;
    border: 1px solid var(--resume-rule);
    border-radius: 999px;
    font-size: 0.67rem;
    font-weight: 680;
    line-height: 1;
    color: var(--color-text-date);
    white-space: nowrap;
  }

  .project-toggle svg {
    width: 0.72rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }

  .project-toggle-close {
    display: none;
  }

  .project-entry[open] .project-toggle-open {
    display: none;
  }

  .project-entry[open] .project-toggle-close {
    display: inline;
  }

  .project-entry[open] .project-summary-main h3 {
    color: var(--color-accent);
  }

  .project-entry[open] .project-toggle {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .project-entry[open] .project-toggle svg {
    transform: rotate(180deg);
  }

  .project-detail {
    margin: 0;
    padding: 1.75rem 2.5rem 2.5rem;
    border-top: 1px solid var(--resume-rule);
    opacity: 0;
    transform: translateY(-0.4rem);
    transition:
      opacity 200ms ease 60ms,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1) 40ms;
  }

  .project-entry[open] .project-detail {
    opacity: 1;
    transform: translateY(0);
  }

  .project-role {
    font-size: 0.7rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .project-change {
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--resume-rule);
    border-radius: 0.7rem;
  }

  .diff-line {
    display: grid;
    grid-template-columns: 1.8rem 3.8rem minmax(0, 1fr);
    align-items: center;
    min-height: 2.15rem;
  }

  .diff-delete {
    background: var(--diff-delete-bg);
  }

  .diff-add {
    background: var(--diff-add-bg);
  }

  .diff-sign {
    display: grid;
    align-self: stretch;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .diff-delete .diff-sign {
    background: var(--diff-delete-gutter);
    color: var(--diff-delete-text);
  }

  .diff-add .diff-sign {
    background: var(--diff-add-gutter);
    color: var(--diff-add-text);
  }

  .diff-line small {
    padding-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .diff-delete small,
  .diff-delete strong {
    color: var(--diff-delete-text);
  }

  .diff-add small,
  .diff-add strong {
    color: var(--diff-add-text);
  }

  .diff-line strong {
    padding: 0.38rem 0.75rem 0.38rem 0.3rem;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.5;
    word-break: keep-all;
  }

  .diff-impact {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.58rem 0.75rem;
    border-top: 1px solid var(--resume-rule);
    background: var(--color-bg-card);
  }

  .diff-impact > span {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-accent);
  }

  .diff-impact strong {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--color-text-primary);
  }

  .project-content {
    margin-top: 2.5rem;
  }

  .project-content :global(h2:not(:first-child)) {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--resume-rule);
  }

  .project-content :global(h2) {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .project-content :global(p) {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .project-content :global(p + p) {
    margin-top: 0.75rem;
  }

  .project-content :global(strong) {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .project-footer {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--resume-rule);
  }

  .project-link-row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .project-link-row > span {
    padding-top: 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    color: var(--color-text-date);
  }

  .project-footer a {
    width: fit-content;
    font-size: 0.78rem;
    font-weight: 620;
    line-height: 1.5;
    color: var(--color-accent);
  }

  .resume-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    color: var(--color-text-date);
  }

  @media (max-width: 680px) {
    .resume-page {
      padding-top: 2.5rem;
    }

    .resume-header {
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 1.5rem;
    }

    .contact-list {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: left;
    }

    .print-button {
      grid-column: 2;
      grid-row: 1;
    }

    .projects-section {
      margin-top: 2.5rem;
    }

    .section-title {
      align-items: stretch;
      flex-direction: column;
      gap: 0.8rem;
    }

    .section-heading {
      justify-content: space-between;
    }

    .project-view-filter {
      width: 100%;
    }

    .project-summary {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.9rem;
      padding: 1.25rem;
    }

    .project-title-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .project-title-row time {
      padding-left: 0;
      border-left: 0;
    }

    .project-toggle {
      grid-column: 2;
      grid-row: 1;
    }

    .project-detail {
      margin: 0;
      padding: 1.25rem 1.25rem 1.5rem;
    }

    .diff-line {
      grid-template-columns: 1.8rem 3.2rem minmax(0, 1fr);
    }

    .diff-line small {
      padding-left: 0.55rem;
    }

    .diff-impact {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .project-link-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-summary,
    .project-toggle svg,
    .project-detail,
    .project-entry::details-content {
      transition: none;
    }
  }

  @media print {
    :global(html) {
      color-scheme: light;
      font-size: 9.5pt;
    }

    :global(body),
    :global(html.dark body) {
      background: white !important;
      color: #0a0c10 !important;
    }

    :global(body::before),
    :global(body > header),
    :global(body > footer),
    :global(#reading-progress),
    [data-print-hidden] {
      display: none !important;
    }

    :global(main) {
      max-width: none !important;
      padding: 0 !important;
    }

    .resume-page {
      --color-text-primary: #0a0c10;
      --color-text-secondary: #3f454e;
      --color-text-date: #707782;
      --color-accent: #006fff;
      --color-border-secondary: #d8dde5;
      --surface-bg: #ffffff;
      --surface-border: #d8dde5;
      --surface-shadow: none;
      --diff-delete-bg: #ffebe9;
      --diff-delete-gutter: #ffd7d5;
      --diff-delete-text: #82071e;
      --diff-add-bg: #dafbe1;
      --diff-add-gutter: #aceebb;
      --diff-add-text: #116329;
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .resume-header {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10mm;
      padding: 0 0 6mm;
    }

    .identity h1 {
      font-size: 26pt;
    }

    .contact-list {
      font-size: 8pt;
    }

    .print-button {
      display: none;
    }

    .projects-section {
      margin-top: 7mm;
    }

    .section-title {
      padding: 0 0 3mm;
    }

    .section-title h2 {
      font-size: 12pt;
    }

    .section-meta {
      font-size: 7pt;
    }

    .project-stack {
      display: block;
      margin-top: 8mm;
    }

    .project-entry {
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      break-inside: auto;
    }

    .project-entry + .project-entry {
      margin-top: 0;
      padding-top: 14mm;
      break-before: page;
    }

    .project-entry + .project-entry::before {
      content: '권오승 · Frontend Engineer';
      display: block;
      margin-bottom: 8mm;
      padding-bottom: 3mm;
      border-bottom: 1px solid var(--resume-rule);
      font-family: var(--font-mono);
      font-size: 6.5pt;
      letter-spacing: 0.06em;
      color: var(--color-text-date);
    }

    .project-summary {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 4mm 0 5mm;
      border-top: 2px solid var(--color-text-primary);
      border-bottom: 1px solid var(--resume-rule);
    }

    .print-project-index {
      display: block;
      margin-bottom: 2.5mm;
      font-family: var(--font-mono);
      font-size: 6.5pt;
      font-weight: 650;
      letter-spacing: 0.1em;
      color: var(--color-accent);
    }

    .project-title-row {
      justify-content: space-between;
      gap: 4mm;
    }

    .project-summary-main h3 {
      font-size: 16pt;
      line-height: 1.25;
      color: var(--color-text-primary) !important;
    }

    .project-title-row time {
      padding: 0;
      border: 0;
      font-size: 7.5pt;
    }

    .project-summary-main > p {
      margin-top: 2mm;
      font-size: 9pt;
      line-height: 1.55;
    }

    .project-facts {
      gap: 2.5mm;
      margin-top: 4mm;
      padding-top: 4mm;
    }

    .project-facts > div {
      grid-template-columns: 12mm minmax(0, 1fr);
      gap: 3mm;
    }

    .project-facts dt {
      font-size: 7.5pt;
    }

    .project-facts dd > strong {
      font-size: 8.5pt;
    }

    .technology-list {
      gap: 0;
    }

    .technology-list li {
      padding: 0;
      border: 0;
      border-radius: 0;
      font-size: 7.5pt;
    }

    .technology-list li:not(:last-child)::after {
      content: '·';
      margin-inline: 2mm;
      color: var(--color-text-date);
    }

    .project-toggle {
      display: none;
    }

    .project-detail {
      display: block !important;
      margin: 0;
      padding: 5mm 0 0;
      border-top: 0;
      opacity: 1;
      transform: none;
      box-shadow: none;
    }

    .project-role {
      font-size: 7.5pt;
    }

    .project-summary,
    .project-change,
    .project-content :global(h2),
    .project-footer {
      break-inside: avoid;
    }

    .project-change {
      margin-top: 5mm;
      border-radius: 1mm;
    }

    .project-content {
      margin-top: 6mm;
    }

    .project-content :global(h2:not(:first-child)) {
      margin-top: 5mm;
      padding-top: 0;
      border-top: 0;
    }

    .project-content :global(h2:not(:first-child))::before {
      content: '';
      display: block;
      width: 10mm;
      height: 1px;
      margin-bottom: 5mm;
      background: var(--resume-rule);
    }

    .project-content :global(h2) {
      font-size: 11pt;
    }

    .project-content :global(p) {
      margin-top: 2mm;
      font-size: 8.7pt;
      line-height: 1.68;
    }

    .project-footer {
      margin-top: 5mm;
      padding-top: 4mm;
    }

    .resume-footer {
      display: none;
    }

    @page {
      size: A4;
      margin: 14mm 15mm;
    }
  }
</style>

<script>
  const projectEntries = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.project-entry'),
  );
  const projectViewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-project-view]'),
  );
  let projectOpenStates: boolean[] = [];

  const syncProjectView = () => {
    const allOpen = projectEntries.every((project) => project.open);

    projectViewButtons.forEach((button) => {
      const isBrief = button.dataset.projectView === 'brief';
      button.setAttribute(
        'aria-pressed',
        String((isBrief && !allOpen) || (!isBrief && allOpen)),
      );
    });
  };

  projectViewButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const shouldOpen = button.dataset.projectView === 'detail';
      projectEntries.forEach((project) => {
        project.open = shouldOpen;
      });
      syncProjectView();
    });
  });

  projectEntries.forEach((project) => {
    project.addEventListener('toggle', syncProjectView);
  });

  const openLinkedProject = () => {
    if (!window.location.hash) return;

    const linkedProject = document.querySelector<HTMLDetailsElement>(
      window.location.hash,
    );

    if (linkedProject?.classList.contains('project-entry')) {
      linkedProject.open = true;
    }
  };

  document
    .querySelector('[data-print-resume]')
    ?.addEventListener('click', () => {
      window.print();
    });

  window.addEventListener('hashchange', openLinkedProject);
  window.addEventListener('beforeprint', () => {
    projectOpenStates = projectEntries.map((project) => project.open);
    projectEntries.forEach((project) => {
      project.open = true;
    });
  });
  window.addEventListener('afterprint', () => {
    projectEntries.forEach((project, index) => {
      project.open = projectOpenStates[index] ?? false;
    });
  });

  openLinkedProject();
  syncProjectView();
</script>
