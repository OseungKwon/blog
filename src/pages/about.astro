---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const BASE = import.meta.env.BASE_URL;
const formatMonth = (date: string) => date.replace('-', '.');
const projects = await Promise.all(
  (await getCollection('career'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (project) => ({
      ...project,
      Content: (await project.render()).Content,
    })),
);
const projectYears = [
  ...new Set(
    projects.flatMap(({ data }) => [
      data.startDate.slice(0, 4),
      data.endDate.slice(0, 4),
    ]),
  ),
].sort();
const projectYearsLabel =
  projectYears.length > 1
    ? `${projectYears[0]}—${projectYears.at(-1)}`
    : (projectYears[0] ?? '');
const lastUpdated = projects.reduce(
  (latest, { data }) => (data.endDate > latest ? data.endDate : latest),
  '',
);
---

<Layout
  title="경력기술서 · 권오승"
  description="프론트엔드 개발자 권오승의 경력기술서. AI 개발 워크플로우와 웹 주문·결제 시스템 구축 경험을 정리했습니다."
  wide
  profile
>
  <article class="resume-page">
    <header class="resume-header">
      <div class="identity">
        <p>Frontend Engineer</p>
        <h1>권오승</h1>
      </div>

      <div class="contact-list">
        <a href="mailto:00osos@naver.com">00osos@naver.com</a>
        <a
          href="https://github.com/oseungkwon"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/oseungkwon
        </a>
        <a href={BASE}>자몽의 기술블로그</a>
      </div>

      <button
        class="print-button press"
        type="button"
        data-print-resume
        data-print-hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"
          ></path>
        </svg>
        PDF로 저장
      </button>
    </header>

    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-title">
        <h2 id="projects-title">주요 프로젝트</h2>
        <span>{projects.length} projects · {projectYearsLabel}</span>
      </div>

      <div class="project-stack">
        {
          projects.map(({ data, Content }) => (
            <article class="project-card surface">
              <header class="project-header">
                <div class="project-meta">
                  <span>{data.category}</span>
                  <time datetime={`${data.startDate}/${data.endDate}`}>
                    {formatMonth(data.startDate)} — {formatMonth(data.endDate)}
                  </time>
                </div>
                <h3>{data.title}</h3>
                <p class="project-role">{data.roles.join(' · ')}</p>
              </header>

              <section class="project-change" aria-label="프로젝트 변화 요약">
                <div class="diff-line diff-delete">
                  <span class="diff-sign" aria-hidden="true">
                    −
                  </span>
                  <small>before</small>
                  <strong>{data.change.before}</strong>
                </div>
                <div class="diff-line diff-add">
                  <span class="diff-sign" aria-hidden="true">
                    +
                  </span>
                  <small>after</small>
                  <strong>{data.change.after}</strong>
                </div>
                <p class="diff-impact">
                  <span>@@ impact @@</span>
                  <strong>{data.change.impact}</strong>
                </p>
              </section>

              <div class="project-content">
                <Content />
              </div>

              {data.links.length > 0 && (
                <footer class="project-footer">
                  {data.links.map((link) => (
                    <div class="project-link-row">
                      <span>{link.type}</span>
                      <a
                        href={link.external ? link.href : `${BASE}${link.href}`}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noopener noreferrer' : undefined}
                      >
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  ))}
                </footer>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <footer class="resume-footer">
      <span>권오승 · Frontend Engineer</span>
      <span>Updated {formatMonth(lastUpdated)}</span>
    </footer>
  </article>
</Layout>

<style>
  .resume-page {
    width: 100%;
    max-width: 55rem;
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
    --resume-rule: var(--color-border-secondary);
    --diff-delete-bg: #ffebe9;
    --diff-delete-gutter: #ffd7d5;
    --diff-delete-text: #82071e;
    --diff-add-bg: #dafbe1;
    --diff-add-gutter: #aceebb;
    --diff-add-text: #116329;
  }

  :global(.dark) .resume-page {
    --diff-delete-bg: #3f1d1d;
    --diff-delete-gutter: #602020;
    --diff-delete-text: #ffb3ad;
    --diff-add-bg: #1b3a2a;
    --diff-add-gutter: #235d38;
    --diff-add-text: #7ee2a8;
  }

  .resume-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 2rem;
    align-items: end;
    padding: 0 0.5rem 2rem;
    border-bottom: 1px solid var(--resume-rule);
  }

  .identity > p {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .identity h1 {
    margin-top: 0.45rem;
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 730;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .contact-list {
    display: grid;
    gap: 0.32rem;
    padding-bottom: 0.15rem;
    text-align: right;
  }

  .contact-list a {
    font-size: 0.73rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .contact-list a:hover {
    color: var(--color-accent);
  }

  .print-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0 0.85rem;
    border: 1px solid var(--resume-rule);
    border-radius: 999px;
    background: var(--surface-bg);
    color: var(--color-text-primary);
    font-size: 0.73rem;
    font-weight: 650;
    cursor: pointer;
  }

  .print-button svg {
    width: 0.9rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .print-button:focus-visible,
  .contact-list a:focus-visible,
  .project-footer a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .projects-section {
    margin-top: 3rem;
  }

  .section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 0.5rem;
  }

  .section-title h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .section-title span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-date);
  }

  .project-stack {
    display: grid;
    gap: 2rem;
    margin-top: 1rem;
  }

  .project-card {
    overflow: hidden;
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-meta span,
  .project-meta time {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 550;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-meta span {
    color: var(--color-accent);
  }

  .project-meta time {
    color: var(--color-text-date);
    white-space: nowrap;
  }

  .project-header h3 {
    max-width: 42rem;
    margin-top: 1rem;
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    font-weight: 730;
    line-height: 1.2;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }

  .project-role {
    margin-top: 0.7rem;
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .project-change {
    margin-top: 2rem;
    overflow: hidden;
    border: 1px solid var(--resume-rule);
    border-radius: 0.7rem;
  }

  .diff-line {
    display: grid;
    grid-template-columns: 1.8rem 3.8rem minmax(0, 1fr);
    align-items: center;
    min-height: 2.15rem;
  }

  .diff-delete {
    background: var(--diff-delete-bg);
  }

  .diff-add {
    background: var(--diff-add-bg);
  }

  .diff-sign {
    display: grid;
    align-self: stretch;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .diff-delete .diff-sign {
    background: var(--diff-delete-gutter);
    color: var(--diff-delete-text);
  }

  .diff-add .diff-sign {
    background: var(--diff-add-gutter);
    color: var(--diff-add-text);
  }

  .diff-line small {
    padding-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .diff-delete small,
  .diff-delete strong {
    color: var(--diff-delete-text);
  }

  .diff-add small,
  .diff-add strong {
    color: var(--diff-add-text);
  }

  .diff-line strong {
    padding: 0.38rem 0.75rem 0.38rem 0.3rem;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.5;
    word-break: keep-all;
  }

  .diff-impact {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.58rem 0.75rem;
    border-top: 1px solid var(--resume-rule);
    background: var(--color-bg-card);
  }

  .diff-impact > span {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-accent);
  }

  .diff-impact strong {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--color-text-primary);
  }

  .project-content {
    margin-top: 2.5rem;
  }

  .project-content :global(h2:not(:first-child)) {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--resume-rule);
  }

  .project-content :global(h2) {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .project-content :global(p) {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .project-content :global(p + p) {
    margin-top: 0.75rem;
  }

  .project-content :global(strong) {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .project-footer {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--resume-rule);
  }

  .project-link-row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .project-link-row > span {
    padding-top: 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    color: var(--color-text-date);
  }

  .project-footer a {
    width: fit-content;
    font-size: 0.78rem;
    font-weight: 620;
    line-height: 1.5;
    color: var(--color-accent);
  }

  .resume-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    color: var(--color-text-date);
  }

  @media (max-width: 680px) {
    .resume-page {
      padding-top: 2.5rem;
    }

    .resume-header {
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 1.5rem;
    }

    .contact-list {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: left;
    }

    .print-button {
      grid-column: 2;
      grid-row: 1;
    }

    .projects-section {
      margin-top: 2.5rem;
    }

    .project-card {
      border-radius: 1.25rem;
    }

    .project-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .diff-line {
      grid-template-columns: 1.8rem 3.2rem minmax(0, 1fr);
    }

    .diff-line small {
      padding-left: 0.55rem;
    }

    .diff-impact {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .project-link-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  @media print {
    :global(html) {
      color-scheme: light;
      font-size: 9pt;
    }

    :global(body),
    :global(html.dark body) {
      background: white !important;
      color: #0a0c10 !important;
    }

    :global(body::before),
    :global(body > header),
    :global(body > footer),
    :global(#reading-progress),
    [data-print-hidden] {
      display: none !important;
    }

    :global(main) {
      max-width: none !important;
      padding: 0 !important;
    }

    .resume-page {
      --color-text-primary: #0a0c10;
      --color-text-secondary: #3f454e;
      --color-text-date: #707782;
      --color-accent: #006fff;
      --color-border-secondary: #d8dde5;
      --surface-bg: #ffffff;
      --surface-border: #d8dde5;
      --surface-shadow: none;
      --diff-delete-bg: #ffebe9;
      --diff-delete-gutter: #ffd7d5;
      --diff-delete-text: #82071e;
      --diff-add-bg: #dafbe1;
      --diff-add-gutter: #aceebb;
      --diff-add-text: #116329;
      width: 186mm;
      max-width: none;
      margin: 0 auto;
      padding: 0;
    }

    .resume-header {
      padding-bottom: 6mm;
    }

    .identity h1 {
      font-size: 24pt;
    }

    .projects-section {
      margin-top: 8mm;
    }

    .project-stack {
      gap: 0;
      margin-top: 4mm;
    }

    .project-card {
      padding: 9mm;
      border-radius: 4mm;
      box-shadow: none;
      break-inside: auto;
    }

    .project-card + .project-card {
      margin-top: 0;
      break-before: page;
    }

    .project-header,
    .project-change,
    .project-content :global(h2),
    .project-footer {
      break-inside: avoid;
    }

    .project-change {
      margin-top: 6mm;
    }

    .project-content {
      margin-top: 7mm;
    }

    .project-content :global(h2:not(:first-child)) {
      margin-top: 6mm;
      padding-top: 6mm;
    }

    .project-content :global(p) {
      font-size: 8.4pt;
      line-height: 1.72;
    }

    .project-footer {
      margin-top: 6mm;
    }

    .resume-footer {
      display: none;
    }

    @page {
      size: A4;
      margin: 12mm;
    }
  }
</style>

<script>
  document
    .querySelector('[data-print-resume]')
    ?.addEventListener('click', () => {
      window.print();
    });
</script>
