---
import Layout from '../layouts/Layout.astro';

const BASE = import.meta.env.BASE_URL;

const channels = [
  {
    label: 'Email',
    description: '00osos@naver.com',
    href: 'mailto:00osos@naver.com',
    external: false,
  },
  {
    label: 'GitHub',
    description: '코드와 활동 보기',
    href: 'https://github.com/oseungkwon',
    external: true,
  },
  {
    label: 'RSS',
    description: '새 글 구독하기',
    href: `${BASE}rss.xml`,
    external: false,
  },
];
---

<Layout
  title="Contact"
  description="프론트엔드 개발자 오승에게 이메일로 연락하거나 GitHub와 RSS를 확인할 수 있습니다."
>
  <article class="contact-page">
    <header class="contact-hero">
      <p class="contact-eyebrow">Contact</p>
      <h1>
        함께 이야기할 주제가 있다면,<br />
        이메일로 보내주세요.
      </h1>
      <p class="contact-introduction">
        채용, 프로젝트 협업, 기술 글에 대한 의견을 기다립니다.
      </p>
    </header>

    <section class="contact-channels" aria-label="연락 및 구독 링크">
      <ul>
        {
          channels.map((channel) => (
            <li>
              <a
                class="channel-link"
                href={channel.href}
                target={channel.external ? '_blank' : undefined}
                rel={channel.external ? 'noopener noreferrer' : undefined}
              >
                <span class="channel-label">{channel.label}</span>
                <span class="channel-description">{channel.description}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M5 15 15 5M7 5h8v8" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>

<style>
  .contact-page {
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    padding: 4.5rem 0 6rem;
  }

  .contact-eyebrow,
  .channel-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .contact-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-accent);
  }

  .contact-hero h1 {
    max-width: 44rem;
    margin-top: 1.25rem;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 680;
    line-height: 1.15;
    letter-spacing: -0.055em;
    color: var(--color-text-primary);
    word-break: keep-all;
  }

  .contact-introduction {
    margin-top: 1.5rem;
    font-size: 1rem;
    font-weight: 450;
    line-height: 1.7;
    color: var(--color-text-secondary);
    word-break: keep-all;
  }

  .contact-channels {
    margin-top: 4rem;
    border-top: 1px solid var(--color-border-secondary);
  }

  .contact-channels ul {
    list-style: none;
  }

  .contact-channels li {
    border-bottom: 1px solid var(--color-border-secondary);
  }

  .channel-link {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .channel-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-date);
  }

  .channel-description {
    font-size: 1rem;
    font-weight: 550;
  }

  .channel-link svg {
    width: 1rem;
    fill: none;
    stroke: var(--color-text-tertiary);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .channel-link:hover svg {
    transform: translate(0.15rem, -0.15rem);
  }

  .channel-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.35rem;
  }

  @media (max-width: 560px) {
    .contact-page {
      padding-top: 3.25rem;
    }

    .contact-hero h1 {
      font-size: clamp(1.85rem, 8vw, 2.5rem);
    }

    .contact-channels {
      margin-top: 3rem;
    }

    .channel-link {
      grid-template-columns: 5rem minmax(0, 1fr) auto;
    }

    .channel-description {
      overflow-wrap: anywhere;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-link svg {
      transition: none;
    }
  }
</style>
