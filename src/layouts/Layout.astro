---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ReadingProgress from '../components/site/ReadingProgress.astro';
import SeoHead from '../components/site/SeoHead.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ThemeInit from '../components/site/ThemeInit.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  wide?: boolean;
  profile?: boolean;
  noBackdrop?: boolean;
  compactHeader?: boolean;
}

const { title, description, image, imageWidth, imageHeight, article, publishedTime, modifiedTime, tags, wide = false, profile, noBackdrop = false, compactHeader = false } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <SeoHead
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      article={article}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      profile={profile}
    />
    <ThemeInit />
  </head>
  <body class:list={['flex min-h-screen flex-col', { 'no-backdrop': noBackdrop }]}>
    <ReadingProgress />
    <Header wide={wide} compact={compactHeader} />
    <main class:list={['mx-auto w-full flex-1 px-4 pt-4 pb-6 sm:px-6 lg:px-8', wide ? 'max-w-6xl' : 'max-w-5xl']}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
