---
import ThemeToggle from './ThemeToggle.astro';

const BASE = import.meta.env.BASE_URL;
---

<header class="sticky z-50 w-full border-b border-token-primary bg-token-primary top-0">
  <nav class="vt-navbar mx-auto flex max-w-[59rem] items-center justify-between gap-3 px-4 py-2.5 sm:px-6 lg:px-8">
    <a href={BASE} class="group flex min-h-8 items-center gap-1.5 text-[13px] font-semibold text-token-secondary transition-colors hover:text-token-primary" aria-label="기술블로그로 돌아가기">
      <svg
        class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
        <path d="M9 12h10"></path>
      </svg>
      기술블로그
    </a>
    <ThemeToggle compact />
  </nav>
</header>
